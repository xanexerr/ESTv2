# PostgreSQL
POSTGRES_USER=estv2
POSTGRES_PASSWORD=estv2password
POSTGRES_DB=estv2_db
POSTGRES_PORT=5432

# App
APP_PORT=3000
AUTO_SEED=true
TZ=Asia/Bangkok

# Prisma (for local host CLI commands like npm run db:push)
DATABASE_URL="postgresql://estv2:estv2password@localhost:5432/estv2_db?schema=public"
JWT_SECRET="htc-estv2-super-secret-jwt-key-2026"

# Auto-Deploy (Local Polling & Optional Webhook)
DEPLOY_BRANCH=main
DEPLOY_POLL_SECONDS=30
WEBHOOK_PORT=9000
WEBHOOK_SECRET="change-me-to-a-strong-webhook-secret"
