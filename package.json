{
  "name": "htc-est-for-internship-nextjs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "docker:db": "docker compose up -d postgres",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "docker:full": "docker compose up -d --build",
    "deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:force": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Force",
    "deploy:watch": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/auto-deploy-watch.ps1",
    "deploy:webhook": "node scripts/webhook-server.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "clsx": "^2.1.1",
    "jose": "^6.0.10",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
